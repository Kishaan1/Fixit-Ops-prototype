{
  "name": "fixit-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "FIXIT AI — device repair shop diagnostics, workflow and business management platform",
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"tsx watch server/index.ts\" \"vite\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build && tsc --noEmit -p tsconfig.server.json",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:migrate:sheets": "tsx scripts/migrate-sqlite-to-sheets.ts",
    "db:verify:sheets": "tsx scripts/verify-sheets.ts",
    "sheets:setup": "tsx scripts/setup-sheets.ts",
    "test:sheets": "tsx scripts/test-sheets-live.ts",
    "test:engine": "tsx scripts/sheets-engine-smoke.ts",
    "test:api": "tsx scripts/api-smoke.ts",
    "assets:brand": "tsx scripts/generate-brand-assets.ts",
    "android:offline": "tsx scripts/finalize-offline-page.ts",
    "android:version": "tsx scripts/set-android-version.ts",
    "android:qr": "tsx scripts/generate-apk-qr.ts",
    "setup": "npm run db:verify:sheets"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/core": "^7.6.10",
    "@prisma/client": "6.19.3",
    "@tanstack/react-query": "^5.90.5",
    "cookie-parser": "^1.4.7",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.545.0",
    "multer": "^2.0.2",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4",
    "recharts": "^3.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.6.10",
    "@tailwindcss/vite": "^4.1.14",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.7.2",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "prisma": "6.19.3",
    "puppeteer-core": "^25.17.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true,
    "sharp@0.32.6": true
  }
}
