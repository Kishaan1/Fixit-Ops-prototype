# Local development defaults. Copy to .env and change before deploying.
#
# The only database is the owner's existing Google Spreadsheet. A Google Apps
# Script Web App (server/sheets/appsscript/Code.gs) is the write gateway.
# Deploy it first, then paste the /exec URL and the same secret below.
#
# `npm run sheets:setup` generates both secrets, prints the exact deployment
# steps, pings the gateway and creates the master/current-month tabs.
SHEETS_GATEWAY_URL=""
SHEETS_GATEWAY_SECRET=""

# Timezone used for month tabs and timestamps (fixed in code to IST).
# The app always uses Asia/Kolkata.

# Legacy SQLite file. Read only by `npm run db:migrate:sheets` and
# `npm run db:verify:sheets`; the running app never uses it.
# Prisma resolves this relative to prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

PORT=4000
NODE_ENV=development
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
PUBLIC_BASE_URL="http://localhost:5173"

# Preview harness only (scripts/ui-preview-server.ts): shows the one-click
# demo login buttons on /login. Leave false — production never shows these.
DEMO_LOGIN_HINTS=false

# Development convenience: return a password-reset link in the API response.
# Must stay false in production; without an email provider the link is written
# to the server log instead, so an administrator can deliver it securely.
EXPOSE_RESET_TOKENS=true

# Optional AI provider. Leave empty to use the clearly-labelled offline checklist.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Maximum device-photo upload size. Photos are stored in Google Drive; this
# directory is only read by the one-time legacy import.
UPLOAD_DIR=server/uploads
MAX_UPLOAD_MB=8
