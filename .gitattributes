# Normalize text files to LF in the repository and working tree (Node + Android).
* text=auto eol=lf

# Windows batch scripts must keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binaries — never touch line endings.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.zip binary
*.jar binary
*.apk binary
*.aab binary
*.keystore binary
*.jks binary
